# ── Database (required for accounts, team rooms and profiles) ────────────────
# Without it CASEFILE runs in single-device demo mode.
# Use a pooled connection string in serverless deployments (Neon, Supabase pooler…).
DATABASE_URL="postgresql://casefile:casefile@localhost:5432/casefile?schema=public"
# DATABASE_POOL_MAX=5

# Public base URL, used for OAuth callbacks and invite links (no trailing slash).
# Optional — derived from the request host when unset.
# APP_URL="https://casefile.example.com"

# ── Sign-in providers (optional; buttons appear when both values are set) ────
# Callback URLs: <APP_URL>/api/auth/oauth/google/callback and …/github/callback
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# Comma-separated emails that get the admin panel.
# ADMIN_EMAILS="you@example.com"

# ── ORACLE (optional) ────────────────────────────────────────────────────────
# With a key, ORACLE answers in natural language using only evidence the team has
# discovered. Without it, ORACLE uses its deterministic record search.
# ANTHROPIC_API_KEY=""
